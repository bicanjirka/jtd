<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Two of CLAUDE.md 6's naming rules (types UpperCamelCase, constants UPPER_SNAKE_CASE), run by
  `mvn verify`. Enum constant naming (also CLAUDE.md 6) stays a hand-rolled check in
  scripts/VerifyRules.java: Checkstyle's own ConstantName module does not inspect enum constants
  (they're a distinct AST node), and the only module that does is a third-party sevntu-checkstyle
  extension - not worth a second plugin dependency for one rule.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="TypeName"/>
        <module name="ConstantName"/>
    </module>
</module>
